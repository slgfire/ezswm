# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Data
DATA_DIR=/app/data
DATABASE_URL=file:./data/db.sqlite

# Authentication
JWT_SECRET=change-me-to-a-random-secret-in-production

# Optional OIDC SSO (configured in Settings > Authentication, not via env)
# Only needed if you configure an OIDC client secret (confidential client).
# A public client without a secret needs no key. Server-only 32-byte key that
# encrypts the stored secret. Generate with:
#   openssl rand -base64 32   (64-char hex also accepted; must differ from JWT_SECRET)
# Keep it outside backups. Missing/wrong key disables only secret-dependent SSO;
# local login is unaffected.
OIDC_ENCRYPTION_KEY=
# Canonical public https origin used for the callback URL, e.g. https://ezswm.example.com
# (register <origin>/api/auth/oidc/callback with your provider)
# (origin only: no path, credentials, query). Blank = use request origin.
PUBLIC_BASE_URL=
